{
  "name": "sparkpod",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --d1=SPARKPOD_DB --local --ip 0.0.0.0 --port 3000",
    "build": "vite build && node scripts/patch-daytona-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "deploy": "npm run build && wrangler pages deploy dist",
    "db:migrate:local": "wrangler d1 migrations apply SPARKPOD_DB --local"
  },
  "dependencies": {
    "@daytona/sdk": "0.198.0",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "typescript": "^5.9.2",
    "vite": "^5.4.19",
    "vitest": "^2.1.9",
    "wrangler": "^4.131.1"
  }
}
